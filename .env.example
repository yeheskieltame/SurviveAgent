# SurviveAgent Configuration
# ===========================
# All config is managed via: node scripts/agent.mjs config
# Or by talking to Claude in this repo.
#
# No API keys required for paper trading!
# Data sources used (all free/public):
#   - Binance WebSocket (real-time prices)
#   - CoinGecko (market data)
#   - FXTwitter (crypto Twitter/X news)
#   - DeFi Llama (yield pools)
#   - Hyperliquid API (funding rates)
#   - Polymarket Gamma API (prediction markets)
#   - Fear & Greed Index
#
# AI Brain:
#   - Claude Code CLI (install: npm i -g @anthropic-ai/claude-code)
#   - Falls back to heuristic mode if not installed

# Wallet (set via: node scripts/agent.mjs wallet --new)
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# Optional RPC overrides
# ETHEREUM_RPC=https://eth.llamarpc.com
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# SOLANA_RPC=https://api.mainnet-beta.solana.com

# Trading mode: paper or live (default: paper)
# TRADING_MODE=paper
